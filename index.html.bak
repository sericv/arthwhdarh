<!-- Firebase: dynamic news preview on homepage -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, getDocs, query, orderBy, limit }
    from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const firebaseConfig = {
    apiKey: "AIzaSyDnWUCjJKkMqORT8SeLYHszAIP0bv8PCSg",
    authDomain: "arthwhdarh-782ec.firebaseapp.com",
    projectId: "arthwhdarh-782ec",
    storageBucket: "arthwhdarh-782ec.firebasestorage.app",
    messagingSenderId: "597405952213",
    appId: "1:597405952213:web:5ffeab6adc7e451a265a5c"
};
const app = initializeApp(firebaseConfig);
const db  = getFirestore(app);

function fmtDate(ts) {
    if (!ts) return '';
    let d = ts.toDate ? ts.toDate() : (ts.seconds ? new Date(ts.seconds*1000) : new Date(ts));
    return d.toLocaleDateString('ar-SA', { year:'numeric', month:'long', day:'numeric' });
}
function esc(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

async function loadHomeNews() {
    try {
        const q    = query(collection(db,'news'), orderBy('createdAt','desc'), limit(2));
        const snap = await getDocs(q);

        // If no articles exist, keep section hidden completely
        if (snap.empty) return;

        const items = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        const grid    = document.getElementById('hpNewsGrid');
        const section = document.getElementById('hpNewsSection');
        if (!grid || !section) return;

        grid.innerHTML = items.map(n => {
            const thumbSrc = (Array.isArray(n.images) && n.images[0])
                ? n.images[0]
                : (n.imageUrl || null);
            const articleUrl = `news-article.html?id=${encodeURIComponent(n.id)}`;
            return `
            <a href="${articleUrl}" class="hp-news-card" aria-label="${esc(n.title)}">
                <div class="hp-news-card-img-wrap">
                    ${thumbSrc
                        ? `<img class="hp-news-card-img" src="${esc(thumbSrc)}" alt="${esc(n.title)}" loading="lazy">`
                        : `<div class="hp-news-card-img-placeholder"><i class="fas fa-newspaper" aria-hidden="true"></i><span>Heritage · Culture</span></div>`}
                    <div class="hp-news-card-img-overlay"></div>
                </div>
                <div class="hp-news-card-body">
                    <div class="hp-news-card-meta">
                        <span class="hp-news-card-date">${fmtDate(n.date || n.createdAt)}</span>
                        ${n.category ? `<span class="hp-news-card-meta-dot"></span><span class="hp-news-card-category">${esc(n.category)}</span>` : ''}
                    </div>
                    <h3 class="hp-news-card-name">${esc(n.title)}</h3>
                    <p class="hp-news-card-excerpt">${esc(n.excerpt || '')}</p>
                    <div class="hp-news-card-divider"></div>
                    <span class="hp-news-card-link">قراءة الخبر <i class="fas fa-arrow-left"></i></span>
                </div>
            </a>`;
        }).join('');

        // Show section only after cards are populated
        section.style.display = 'block';

        // Trigger scroll-reveal for newly visible elements
        if (window.IntersectionObserver) {
            const io = new IntersectionObserver((entries) => {
                entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); } });
            }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
            section.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));
        } else {
            section.querySelectorAll('[data-reveal]').forEach(el => el.classList.add('revealed'));
        }
    } catch(e) {
        // On any error, keep section hidden — no fake content
        console.warn('Homepage news load error:', e);
    }
}

loadHomeNews();
</script>

<script src="script.js"></script>
<script>
    /* ── Scroll-reveal for homepage sections ── */
    (function () {
        'use strict';

        function initReveal() {
            var targets = document.querySelectorAll('[data-reveal]');
            if (!targets.length || !window.IntersectionObserver) {
                targets.forEach(function(el) { el.classList.add('revealed'); });
                return;
            }

            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('revealed');
                        io.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.10, rootMargin: '0px 0px -40px 0px' });

            targets.forEach(function (el) { io.observe(el); });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initReveal);
        } else {
            initReveal();
        }
    })();

    /* ── Heritage horizontal-scroll track: reveal, drag-to-scroll, progress, parallax ── */
    (function () {
        'use strict';

        var track = document.getElementById('heritageTrack');
        if (!track) return;

        var fill = document.getElementById('heritageProgressFill');
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* Reveal the whole track with a fade + slide-up, staggered per card via CSS */
        if (window.IntersectionObserver) {
            var revealIO = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        track.classList.add('revealed');
                        revealIO.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
            revealIO.observe(track);
        } else {
            track.classList.add('revealed');
        }

        /* Scroll progress indicator (RTL-aware: track scrolls from right to left) */
        function updateProgress() {
            if (!fill) return;
            var max = track.scrollWidth - track.clientWidth;
            var pct = max > 0 ? Math.min(1, Math.abs(track.scrollLeft) / max) : 0;
            fill.style.width = (18 + pct * 82) + '%';
        }
        track.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();

        /* Subtle parallax: shift each card's image opposite to scroll direction */
        var cards = Array.prototype.slice.call(track.querySelectorAll('.hp-hcard'));
        function updateParallax() {
            if (reduceMotion) return;
            var trackRect = track.getBoundingClientRect();
            var trackCenter = trackRect.left + trackRect.width / 2;
            cards.forEach(function (card) {
                var img = card.querySelector('.hp-hcard-img');
                if (!img) return;
                var rect = card.getBoundingClientRect();
                var cardCenter = rect.left + rect.width / 2;
                var delta = (cardCenter - trackCenter) / trackRect.width;
                var shift = Math.max(-1, Math.min(1, delta)) * -14;
                img.style.transform = 'translateY(-2%) translateX(' + shift.toFixed(2) + 'px) scale(1.04)';
            });
        }
        var parallaxRAF = null;
        function requestParallax() {
            if (parallaxRAF) return;
            parallaxRAF = requestAnimationFrame(function () {
                parallaxRAF = null;
                updateParallax();
            });
        }
        track.addEventListener('scroll', requestParallax, { passive: true });
        window.addEventListener('resize', requestParallax);
        requestParallax();

        /* Drag-to-scroll (mouse + touch via pointer events) */
        var isDown = false;
        var startX = 0;
        var startScroll = 0;
        var moved = false;

        track.addEventListener('pointerdown', function (e) {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            isDown = true;
            moved = false;
            startX = e.clientX;
            startScroll = track.scrollLeft;
            track.classList.add('is-dragging');
            track.setPointerCapture(e.pointerId);
        });

        track.addEventListener('pointermove', function (e) {
            if (!isDown) return;
            var dx = e.clientX - startX;
            if (Math.abs(dx) > 4) moved = true;
            track.scrollLeft = startScroll - dx;
        });

        function endDrag(e) {
            if (!isDown) return;
            isDown = false;
            track.classList.remove('is-dragging');
            if (moved) {
                /* Prevent the click/navigation that follows a drag */
                var blockClick = function (ev) { ev.preventDefault(); ev.stopPropagation(); track.removeEventListener('click', blockClick, true); };
                track.addEventListener('click', blockClick, true);
            }
        }
        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);
        track.addEventListener('pointerleave', function () { if (isDown) endDrag(); });
    })();

    /* ── Volunteer horizontal-scroll track: reveal, drag-to-scroll, progress + modal triggers ── */
    (function () {
        'use strict';

        var track = document.getElementById('volunteerTrack');
        if (!track) return;

        var fill = document.getElementById('volunteerProgressFill');

        /* Reveal the whole track with a fade + slide-up, staggered per card via CSS */
        if (window.IntersectionObserver) {
            var revealIO = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        track.classList.add('revealed');
                        revealIO.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
            revealIO.observe(track);
        } else {
            track.classList.add('revealed');
        }

        /* Scroll progress indicator (RTL-aware: track scrolls from right to left) */
        function updateProgress() {
            if (!fill) return;
            var max = track.scrollWidth - track.clientWidth;
            var pct = max > 0 ? Math.min(1, Math.abs(track.scrollLeft) / max) : 0;
            fill.style.width = (32 + pct * 68) + '%';
        }
        track.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();

        /* Drag-to-scroll (mouse + touch via pointer events) */
        var isDown = false;
        var startX = 0;
        var startScroll = 0;
        var moved = false;

        track.addEventListener('pointerdown', function (e) {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            isDown = true;
            moved = false;
            startX = e.clientX;
            startScroll = track.scrollLeft;
            track.classList.add('is-dragging');
            track.setPointerCapture(e.pointerId);
        });

        track.addEventListener('pointermove', function (e) {
            if (!isDown) return;
            var dx = e.clientX - startX;
            if (Math.abs(dx) > 4) moved = true;
            track.scrollLeft = startScroll - dx;
        });

        function endDrag() {
            if (!isDown) return;
            isDown = false;
            track.classList.remove('is-dragging');
            if (moved) {
                /* Prevent the click/modal-open that follows a drag */
                var blockClick = function (ev) { ev.preventDefault(); ev.stopPropagation(); track.removeEventListener('click', blockClick, true); };
                track.addEventListener('click', blockClick, true);
            }
        }
        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);
        track.addEventListener('pointerleave', function () { if (isDown) endDrag(); });

        /* Card click → open the matching registration modal */
        track.querySelectorAll('[data-open-modal]').forEach(function (card) {
            card.addEventListener('click', function () {
                var which = card.getAttribute('data-open-modal');
                if (which === 'bidaya' && typeof window.openBidayaModal === 'function') {
                    window.openBidayaModal();
                } else if (which === 'friend' && typeof window.openFriendModal === 'function') {
                    window.openFriendModal();
                }
            });
        });
    })();
</script>
<script type="module" src="maintenance.js"></script>
</body>
</html>
