# ══════════════════════════════════════════════════════════
# متغيرات البيئة — البوابة الداخلية (نموذج)
# انسخ هذا الملف إلى .env واملأ القيم الفعلية.
# لا ترفع .env إلى Git إطلاقاً.
# ══════════════════════════════════════════════════════════

# ── Firebase (المفاتيح العامة — آمنة للواجهة) ──
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# ── FCM ──
# المفتاح العام (Pair / Public VAPID Key) — يُستخدم في المتصفح
VAPID_KEY=YOUR_PUBLIC_VAPID_KEY

# ⚠️ المفتاح الخاص (Private VAPID Key) لا يوضع هنا ولا في أي ملف واجهة.
# يُحفظ فقط في متغيرات بيئة الخادم (Cloud Functions / Backend)
# لإرسال إشعارات FCM من جهة الخادم:
# VAPID_PRIVATE_KEY=__server_side_only__
