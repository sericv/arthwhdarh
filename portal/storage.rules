rules_version = '2';
// ══════════════════════════════════════════════════════════
// قواعد أمان Firebase Storage — بوابة الموظفين
// ══════════════════════════════════════════════════════════
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }

    // جميع مرفقات البوابة والملفات الشخصية والإجازات
    match /portal/{allPaths=**} {
      allow read:  if signedIn();
      allow write: if signedIn() && request.resource.size < 35 * 1024 * 1024;
      allow delete: if signedIn();
    }
  }
}
